{
  "name": "da40-computer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check": "tsc --noEmit",
    "build:static": "node scripts/copy-static.mjs",
    "build:scripts": "tsc",
    "build:service-worker": "node scripts/build-service-worker.mjs",
    "build": "npm run clean && npm run build:static && npm run build:scripts && npm run build:service-worker",
    "verify": "node scripts/verify-build.mjs && node --test --test-concurrency=1",
    "test": "npm run build && npm run verify",
    "prestart": "npm run build",
    "start": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "json-url": "4.0.0",
    "typescript": "5.9.3"
  }
}
